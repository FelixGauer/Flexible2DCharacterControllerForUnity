  input: {fileID: 0}
  defaultNext: {fileID: 0}
  teleportLocation: {fileID: 0}
  canTeleport: 0
  whostalking: ???
  dialogText:
  - "Her smile thins\u2014like a crack in her armor."
  - "She keeps her eyes on the prep table, tracing a scuffed line in the metal with
    her thumb. Voice lower and a little raspy: \u201CIt\u2019s not even the party.
    It\u2019s knowing you weren\u2019t worth the walk.\u201D"
  - "She laughs once\u2014quiet, bitter, then shakes her head. "
  character_img: {fileID: 1907135731579713948, guid: 9ac2dd82b0c7f8f489ec7ffbec9cffb6, type: 3}
  background_img: {fileID: 0}
  emotionColor: {fileID: 11400000, guid: cb1f22ff349987846a402be7c9a65da5, type: 2}
