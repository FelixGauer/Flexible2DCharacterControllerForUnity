  teleportLocation: {fileID: 0}
  canTeleport: 0
  whostalking: MC
  dialogText:
  - 'Your heart is stuck in your throat there for a second. '
  - You pull out your phone. <Make sure she doesn't see your trembling fingers.>
  - <Or notice the tremble in your voice.>
  - '"Sure. Do you want to take it in front of the fryer or the broken ice cream
    machine?"'
  character_img: {fileID: -5365129548077109440, guid: a60307d3026a28a4e85fc9b480851209, type: 3}
  background_img: {fileID: 0}
