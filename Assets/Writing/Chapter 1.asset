  input: {fileID: 0}
  defaultNext: {fileID: 0}
  teleportLocation: {fileID: 0}
  canTeleport: 0
  whostalking: ???
  dialogText:
  - "\u201CSorry. That was dramatic. I blame the lack of fries.\u201D"
  - She straightens, visibly pulls herself back into the  cool punk girl persona.
  - "\u201CHey, I know this is weird, but my phone\u2019s dead and I kind of want
    proof I didn\u2019t spend the night alone like a loser. Can we take a selfie
    on your phone? Just one. I\u2019ll send it to myself later.\u201D"
  - "She lifts her eyebrows, joking tone returning. \u201CCome on. You\u2019ll make
    me look like I have at least one friend in the universe.\u201D"
  character_img: {fileID: -4707300980396986800, guid: 216ec158df500d2449fc49a3ffb9dd4f, type: 3}
  background_img: {fileID: 0}
  emotionColor: {fileID: 11400000, guid: ce77a67d105fdbb4a8623fd1ef3d64d4, type: 2}
