  whostalking: MC
  dialogText:
  - You have your phone ready. She leans in, fries in hand, head tilted toward yours,
    and smiles.
  - The distance between your bodies narrows.
  - Her hair brushes your cheek.
  - You feel the warm tingle of her breath on your neck.
  character_img: {fileID: -5365129548077109440, guid: a60307d3026a28a4e85fc9b480851209, type: 3}
  background_img: {fileID: 0}
  emotionColor: {fileID: 0}
