  defaultNext: {fileID: 0}
  teleportLocation: {fileID: 0}
  canTeleport: 0
  whostalking: ???
  dialogText:
  - "\u201COkay, done! If I blinked, we\u2019re taking a hundred more. Let me seeeee!!!\u201D"
  - "She peers at your screen, leaning in close again. \u201COh wow. You look cooler
    than you think.\u201D"
  - "She hands the phone back to you\u2014screen unlocked, her photo open\u2014 \u201CCan
    you send it to me? Here\u2014let me type my contact.\u201D She lightly taps your
    phone, waiting for you to unlock it again."
  - You unlock it wordlessly with trembling fingers.
  - She types in a number, and adds her name.
  character_img: {fileID: -9161298043115877563, guid: 6f5b357a0225308419df29447a66e28f, type: 3}
  background_img: {fileID: 0}
  emotionColor: {fileID: 11400000, guid: ce77a67d105fdbb4a8623fd1ef3d64d4, type: 2}
