  input: {fileID: 0}
  defaultNext: {fileID: 0}
  teleportLocation: {fileID: 0}
  canTeleport: 0
  whostalking: ???
  dialogText:
  - "She laughs brighly. \n\n\u201CObviously the broken ice cream machine. It\u2019
    matches my energy.\u201D"
  - "She steps closer, shoulder brushing yours\u2014not aggressive, just close enough
    to fit in a selfie frame. "
  - "She lifts her hand to fix her hair, then pauses. \u201CActually\u2026 hold on.\u201D "
  - "She reaches behind her to the prep table, grabs a small stack of fry boats,
    and sets them on the counter.  \u201CYou\u2019re taller. Hold the phone. Better
    angle. I\u2019ll pretend I work here and you pretend you don\u2019t hate your
    life.\u201D\r"
  character_img: {fileID: -9161298043115877563, guid: 6f5b357a0225308419df29447a66e28f, type: 3}
  background_img: {fileID: 0}
  emotionColor: {fileID: 0}
