  defaultNext: {fileID: 0}
  teleportLocation: {fileID: 0}
  canTeleport: 0
  whostalking: ???
  dialogText:
  - '"Okay, onion rings and fries and a large coke then."'
  - 
  - "\u201CSo every Saturday is a crisis? That's consistent, at least.\u201D \nShe
    taps the menu board with one finger."
  - "\u201CActually\u2014can you make that to go? My friend bailed on me, and I\u2019d
    rather not sit here looking like someone stood me up.\u201D"
  character_img: {fileID: -5365129548077109440, guid: a60307d3026a28a4e85fc9b480851209, type: 3}
  background_img: {fileID: 0}
  emotionColor: {fileID: 0}
