  teleportLocation: {fileID: 0}
  canTeleport: 0
  whostalking: MC
  dialogText:
  - '"Going for the hardcore questions right away, I see." - you say deflectingly
    as you throw the food into the fryer.'
  - '"So that friend of your that stood you up - does that happen more often?" You
    throw her another crooked smile.'
