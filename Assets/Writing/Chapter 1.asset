  teleportLocation: {fileID: 0}
  canTeleport: 0
  whostalking: MC
  dialogText:
  - 'Your neck is tingling from the attention. You weirdly feel like you are on some
    kind of test. '
  - '"I... stay.", you say slowly. "I am very steady."'
  - '"So that friend of yours - what did you have planned for tonight for her?"'
  - '"Please say she", you pray to yourself.'
