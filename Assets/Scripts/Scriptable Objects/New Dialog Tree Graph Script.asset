  nodeID: 4
  teleportLocation: {fileID: 0}
  whostalking: ???
  dialogText:
  - "\u201CIn that case, make it something tragic and greasy. Fries. Onion rings.
    How big is a big coke?\u201D  She leans on the counter, studying you\u2014not
    flirting, just present."
  character_img: {fileID: 5191031541360726387, guid: b7dc5f4f6e92d5e46a2844660c6f7a55, type: 3}
